# Server
PORT=8000
API_PREFIX=/api/v1/
CORS_ORIGIN=http://localhost:5173

# Health service mode
AWS_REGION=il-central-1
HEALTH_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-health
# Reads: GET /me, GET /admin/users, GET /admin/users/:id → get_user_by_id / get_all_users
USER_INFO_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-get-user-info
# Mutations (PATCH profile, role, DELETE user) — separate function; verify actions exist in that Lambda
USER_MANAGEMENT_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-write-user-rds
STATIONS_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-get-station-info
STATIONS_LAMBDA_WRITE_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-write-station-rds


# Auth (AWS Cognito)
AUTH_DISABLED=true
COGNITO_REGION=il-central-1
COGNITO_USER_POOL_ID=il-central-1_dVQbiQE07
COGNITO_CLIENT_ID=70ct74soj95kqqs4n6kld970m

# Logging
LOG_LEVEL=debug
# `local` → UsersServiceLocal (no Lambda). Use e.g. `development` or `production` to use UsersServiceLambda.
ENVIRONMENT=local
