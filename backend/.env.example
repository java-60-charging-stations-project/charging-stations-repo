# Server
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Microservices (AWS)
AWS_REGION=il-central-1
HEALTH_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-health
USER_INFO_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-get-user-info
USER_MANAGEMENT_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-write-user-rds
STATIONS_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-get-station-info
STATIONS_LAMBDA_WRITE_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-write-station-rds
STATIONS_PORTS_READ_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-get-ports-sessions-dynamo

# RDS logs Lambdas (USE_LAMBDA=true): read = getLogs, write = resolveLog / write_logs
# LOGS_READ_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-read-logs-rds
# LOGS_WRITE_LAMBDA_FUNCTION_NAME=arn:aws:lambda:il-central-1:852215679994:function:charging-stations-write-logs-rds

# Auth (AWS Cognito)
AUTH_DISABLED=false
COGNITO_REGION=il-central-1
COGNITO_USER_POOL_ID=il-central-1_nfWmKzF6n
COGNITO_CLIENT_ID=3s9skrc7oievsvsu6usm0e6hdj
COGNITO_CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::852215679994:role/sam-db-lambdas-cognito-cross-account
COGNITO_CROSS_ACCOUNT_EXTERNAL_ID=charging-stations-backend

# ENVIRONMENT
NODE_ENV=production
LOG_LEVEL=debug
ENVIRONMENT=production

# Valkey / Redis-compatible cache (optional)
# VALKEY_ENABLED=false
# VALKEY_URL=rediss://default:token@your-cluster.cache.amazonaws.com:6379
# VALKEY_HOST=localhost
# VALKEY_PORT=6379
# VALKEY_TLS=true
# VALKEY_TLS_REJECT_UNAUTHORIZED=true
# VALKEY_USERNAME=
# VALKEY_PASSWORD=
# VALKEY_DB=0
# VALKEY_KEY_PREFIX=charging:
# VALKEY_CONNECT_TIMEOUT_MS=10000
